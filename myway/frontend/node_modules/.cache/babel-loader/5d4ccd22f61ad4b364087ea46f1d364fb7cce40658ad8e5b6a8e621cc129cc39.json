{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      isAuthenticated: false,\n      showForm: false,\n      orderForm: {\n        name: '',\n        email: '',\n        phone: ''\n      }\n    };\n  },\n  async created() {\n    await this.checkAuth();\n  },\n  methods: {\n    async checkAuth() {\n      try {\n        const response = await axios.get('http://localhost:8000/api/authenticated/', {\n          withCredentials: true,\n          headers: {\n            'Accept': 'application/json' // Явно запрашиваем JSON\n          }\n        });\n        this.isAuthenticated = response.data.isAuthenticated;\n      } catch (error) {\n        console.error('Auth error:', error.response?.data);\n        this.isAuthenticated = false;\n      }\n    },\n    async handleRequestOrder() {\n      // Всегда проверяем актуальный статус перед действием\n      await this.checkAuth();\n      if (this.isAuthenticated) {\n        this.showForm = true;\n      } else {\n        this.$router.push('/login'); // Используем Vue Router вместо window.location\n      }\n    },\n    async submitOrder() {\n      if (!this.orderForm.name || !this.orderForm.email || !this.orderForm.phone) {\n        alert('Please fill out all fields.');\n        return;\n      }\n      try {\n        await axios.post('http://localhost:8000/api/request-order/', this.orderForm, {\n          withCredentials: true\n        });\n        alert('Order submitted successfully!');\n        this.showForm = false;\n        this.orderForm = {\n          name: '',\n          email: '',\n          phone: ''\n        };\n      } catch (error) {\n        console.error('Order submission failed:', error);\n\n        // Если ошибка 401 (Unauthorized), обновляем статус\n        if (error.response?.status === 401) {\n          this.isAuthenticated = false;\n          this.showForm = false;\n          this.$router.push('/login');\n        } else {\n 