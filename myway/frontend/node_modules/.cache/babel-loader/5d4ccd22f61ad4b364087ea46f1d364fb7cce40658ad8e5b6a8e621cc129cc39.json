dleRequestOrder() {\r\n      // Всегда проверяем актуальный статус перед действием\r\n      await this.checkAuth();\r\n\r\n      if (this.isAuthenticated) {\r\n        this.showForm = true;\r\n      } else {\r\n        this.$router.push('/login'); // Используем Vue Router вместо window.location\r\n      }\r\n    },\r\n    async submitOrder() {\r\n      if (!this.orderForm.name || !this.orderForm.email || !this.orderForm.phone) {\r\n        alert('Please fill out all fields.');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        await axios.post(\r\n          'http://localhost:8000/api/request-order/',\r\n          this.orderForm,\r\n          { withCredentials: true }\r\n        );\r\n        alert('Order submitted successfully!');\r\n        this.showForm = false;\r\n        this.orderForm = { name: '', email: '', phone: '' };\r\n      } catch (error) {\r\n        console.error('Order submission failed:', error);\r\n\r\n        // Если ошибка 401 (Unauthorized), обновляем статус\r\n        if (error.response?.status === 401) {\r\n          this.isAuthenticated = false;\r\n          this.showForm = false;\r\n          this.$router.push('/login');\r\n        } else {\r\n          alert('Failed to submit the order. Please try again.');\r\n        }\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":";AAgBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,eAAe,EAAE,KAAK;MACtBC,QAAQ,EAAE,KAAK;MACfC,SAAS,EAAE;QACTC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE;MACT;IACF,CAAC;EACH,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,SAAS,CAAC,CAAC;EACxB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,SAASA,CAAA,EAAG;MAChB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMX,KAAK,CAACY,GAAG,CAAC,0CAA0C,EAAE;UAC3EC,eAAe,EAAE,IAAI;UACrBC,OAAO,EAAE;YACP,QAAQ,EAAE,kBAAiB,CAAG;UAChC;QACF,CAAC,CAAC;QACF,IAAI,CAACZ,eAAc,GAAIS,QAAQ,CAACV,IAAI,CAACC,eAAe;MACtD,EAAE,OAAOa,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,aAAa,EAAEA,KAAK,CAACJ,QAAQ,EAAEV,IAAI,CAAC;QAClD,IAAI,CAACC,eAAc,GA