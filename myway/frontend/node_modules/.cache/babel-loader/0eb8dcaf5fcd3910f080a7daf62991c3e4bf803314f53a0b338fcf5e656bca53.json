{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'MainNavbar',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const error = ref('');\n    const handleLogout = async () => {\n      try {\n        await store.dispatch('logout');\n        router.push('/login');\n      } catch (error) {\n        console.error('Logout failed:', error);\n        // Можно добавить уведомление пользователю\n      }\n    };\n    return {\n      isAuthenticated,\n      username,\n      handleLogout\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","useRouter","name","setup","store","router","error","ref","handleLogout","dispatch","push","console","isAuthenticated","username"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\MainNavbar.vue"],"sourcesContent":["<template>\r\n  <nav class=\"navbar\">\r\n    <ul class=\"nav-left\">\r\n      <li>\r\n        <router-link to=\"/\">\r\n          <img src=\"@/assets/logocar.svg\" alt=\"Logo\" class=\"logo\" />\r\n        </router-link>\r\n      </li>\r\n      <li><router-link to=\"/\">Home</router-link></li>\r\n      <li><router-link to=\"/catalogue\">Catalogue</router-link></li>\r\n      <li><router-link to=\"/about-us\">About Us</router-link></li>\r\n    </ul>\r\n    <ul class=\"nav-right\">\r\n      <!-- Показываем эти ссылки только неавторизованным пользователям -->\r\n      <template v-if=\"!isAuthenticated\">\r\n        <li><router-link to=\"/login\" class=\"auth-link\">Login</router-link></li>\r\n        <li><router-link to=\"/register\" class=\"auth-link\">Register</router-link></li>\r\n      </template>\r\n      <!-- Показываем для авторизованных пользователей -->\r\n      <template v-else>\r\n        <li class=\"user-info\">\r\n          <span class=\"username\">{{ username }}</span>\r\n        </li>\r\n        <li><button @click=\"handleLogout\" class=\"logout-btn\">Logout</button></li>\r\n      </template>\r\n    </ul>\r\n  </nav>\r\n</template>\r\n\r\n<script>\r\nimport { computed } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { useRouter } from 'vue-router'\r\n\r\nexport default {\r\n  name: 'MainNavbar',\r\n  setup() {\r\n    const store = useStore()\r\n    const router = useRouter()\r\n    const error = ref('')\r\n\r\n    const handleLogout = async () => {\r\n      try {\r\n        await store.dispatch('logout')\r\n        router.push('/login')\r\n      } catch (error) {\r\n        console.error('Logout failed:', error)\r\n        // Можно добавить уведомление пользователю\r\n      }\r\n    }\r\n\r\n    return {\r\n      isAuthenticated,\r\n      username,\r\n      handleLogout\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.navbar {\r\n  background-color: #333;\r\n  overflow: hidden;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  padding: 0 20px;\r\n}\r\n\r\n.nav-left, .nav-right {\r\n  list-style-type: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.navbar li {\r\n  float: left;\r\n}\r\n\r\n.navbar li a {\r\n  display: block;\r\n  color: white;\r\n  text-align: center;\r\n  padding: 14px 16px;\r\n  text-decoration: none;\r\n}\r\n\r\n.navbar li a:hover {\r\n  background-color: #111;\r\n}\r\n\r\n.logo {\r\n  width: 110px;\r\n  height: 15px;\r\n}\r\n\r\n.auth-link {\r\n  color: #fff;\r\n  padding: 8px 16px;\r\n  border-radius: 4px;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.auth-link:hover {\r\n  background-color: #444;\r\n}\r\n\r\n.logout-btn {\r\n  background-color: #dc3545;\r\n  color: white;\r\n  border: none;\r\n  padding: 8px 16px;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  margin: 8px;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.logout-btn:hover {\r\n  background-color: #c82333;\r\n}\r\n\r\n.user-info {\r\n  color: #fff;\r\n  padding: 14px 16px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.username {\r\n  color: #fff;\r\n  margin-right: 10px;\r\n}\r\n</style>"],"mappings":";AA8BA,SAASA,QAAO,QAAS,KAAI;AAC7B,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,KAAI,GAAIC,GAAG,CAAC,EAAE;IAEpB,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF,MAAMJ,KAAK,CAACK,QAAQ,CAAC,QAAQ;QAC7BJ,MAAM,CAACK,IAAI,CAAC,QAAQ;MACtB,EAAE,OAAOJ,KAAK,EAAE;QACdK,OAAO,CAACL,KAAK,CAAC,gBAAgB,EAAEA,KAAK;QACrC;MACF;IACF;IAEA,OAAO;MACLM,eAAe;MACfC,QAAQ;MACRL;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}