{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      car: null,\n      // Инициализируем как null\n      isAuthenticated: false,\n      showForm: false,\n      orderForm: {\n        name: '',\n        email: '',\n        phone: ''\n      }\n    };\n  },\n  async created() {\n    await this.fetchCar();\n    await this.checkAuth();\n  },\n  methods: {\n    async fetchCar() {\n      try {\n        const carId = this.$route.params.id;\n        const response = await axios.get(`http://localhost:8000/api/cars/${carId}/`);\n        this.car = response.data;\n      } catch (error) {\n        console.error('Error fetching car:', error);\n        this.$router.push('/catalogue');\n      }\n    },\n    getImageUrl(imagePath) {\n      if (!imagePath) return '';\n      return imagePath.startsWith('http') ? imagePath : `http://localhost:8000${imagePath}`;\n    },\n    formatPrice(price) {\n      return parseFloat(price).toLocaleString();\n    },\n    async checkAuth() {\n      try {\n        const response = await axios.get('http://localhost:8000/api/authenticated/', {\n          withCredentials: true\n        });\n        this.isAuthenticated = response.data.isAuthenticated;\n      } catch (error) {\n        console.error('Auth check error:', error);\n        this.isAuthenticated = false;\n      }\n    },\n    async handleRequestOrder() {\n      await this.checkAuth();\n      if (this.isAuthenticated) {\n        this.showForm = !this.showForm;\n      } else {\n        this.$router.push({\n          name: 'LoginPage'\n        });\n        alert('Please login to place an order');\n      }\n    },\n    async submitOrder() {\n      try {\n        await axios.post('http://localhost:8000/api/request-order/', this.orderForm, {\n          withCredentials: true\n        });\n        alert('Order submitted successfully!');\n        this.showForm = false;\n        this.orderForm = {\n          name: '',\n          email: '',\n          phone: ''\n        };\n      } catch (error) {\n        if (error.response?.status === 401) {\n          this.isAuthenticated = false;\n          this.showForm = false;\n          this.$router.push('/login');\n        } else {\n          alert('Error: ' + (error.response?.data?.message || 'Order submission failed'));\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","car","isAuthenticated","showForm","orderForm","name","email","phone","created","fetchCar","checkAuth","methods","carId","$route","params","id","response","get","error","console","$router","push","getImageUrl","imagePath","startsWith","formatPrice","price","parseFloat","toLocaleString","withCredentials","handleRequestOrder","alert","submitOrder","post","status","message"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"car-detail-container\" v-if=\"car\">\r\n    <!-- Проверяем наличие car перед отображением -->\r\n    <div class=\"car-image w-full lg:w-1/2\">\r\n      <img :src=\"getImageUrl(car.image)\" alt=\"Car Image\" class=\"rounded-lg w-full h-auto shadow-md\" />\r\n    </div>\r\n\r\n    <!-- Right Section: Details -->\r\n    <div class=\"car-details w-full lg:w-1/2 bg-white p-6 rounded-lg shadow-md flex flex-col justify-between\">\r\n      <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">{{ car.title }}</h1>\r\n      <p class=\"text-gray-600 mb-2\"><strong>Brand:</strong> {{ car.brand }}</p>\r\n      <p class=\"text-gray-600 mb-2\"><strong>Model:</strong> {{ car.model }}</p>\r\n      <p class=\"text-2xl font-bold text-gray-800 mb-6\">${{ formatPrice(car.price) }}</p>\r\n      <p class=\"text-gray-600 mb-4\">{{ car.description }}</p>\r\n    </div>\r\n\r\n    <button @click=\"handleRequestOrder\" class=\"mt-6 px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 transition\">\r\n      Request Order\r\n    </button>\r\n\r\n    <div v-if=\"isAuthenticated && showForm\" class=\"order-form mt-6 p-4 bg-gray-50 rounded-lg\">\r\n      <form @submit.prevent=\"submitOrder\" class=\"space-y-4\">\r\n        <input v-model=\"orderForm.name\" placeholder=\"Full Name\" required\r\n               class=\"w-full px-3 py-2 border rounded\">\r\n        <input v-model=\"orderForm.email\" type=\"email\" placeholder=\"Email\" required\r\n               class=\"w-full px-3 py-2 border rounded\">\r\n        <input v-model=\"orderForm.phone\" type=\"tel\" placeholder=\"Phone Number\" required\r\n               class=\"w-full px-3 py-2 border rounded\">\r\n        <button type=\"submit\"\r\n                class=\"px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600 transition\">\r\n          Submit Order\r\n        </button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n  <div v-else class=\"text-center py-12\">\r\n    <p class=\"text-xl text-gray-500\">Loading car details...</p>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      car: null, // Инициализируем как null\r\n      isAuthenticated: false,\r\n      showForm: false,\r\n      orderForm: {\r\n        name: '',\r\n        email: '',\r\n        phone: '',\r\n      },\r\n    };\r\n  },\r\n  async created() {\r\n    await this.fetchCar();\r\n    await this.checkAuth();\r\n  },\r\n  methods: {\r\n    async fetchCar() {\r\n      try {\r\n        const carId = this.$route.params.id;\r\n        const response = await axios.get(`http://localhost:8000/api/cars/${carId}/`);\r\n        this.car = response.data;\r\n      } catch (error) {\r\n        console.error('Error fetching car:', error);\r\n        this.$router.push('/catalogue');\r\n      }\r\n    },\r\n    getImageUrl(imagePath) {\r\n      if (!imagePath) return '';\r\n      return imagePath.startsWith('http') ? imagePath : `http://localhost:8000${imagePath}`;\r\n    },\r\n    formatPrice(price) {\r\n      return parseFloat(price).toLocaleString();\r\n    },\r\n    async checkAuth() {\r\n      try {\r\n        const response = await axios.get('http://localhost:8000/api/authenticated/', {\r\n          withCredentials: true\r\n        });\r\n        this.isAuthenticated = response.data.isAuthenticated;\r\n      } catch (error) {\r\n        console.error('Auth check error:', error);\r\n        this.isAuthenticated = false;\r\n      }\r\n    },\r\n    async handleRequestOrder() {\r\n      await this.checkAuth();\r\n\r\n      if (this.isAuthenticated) {\r\n        this.showForm = !this.showForm;\r\n      } else {\r\n        this.$router.push({ name: 'LoginPage' });\r\n        alert('Please login to place an order');\r\n      }\r\n    },\r\n    async submitOrder() {\r\n      try {\r\n        await axios.post(\r\n          'http://localhost:8000/api/request-order/',\r\n          this.orderForm,\r\n          { withCredentials: true }\r\n        );\r\n        alert('Order submitted successfully!');\r\n        this.showForm = false;\r\n        this.orderForm = { name: '', email: '', phone: '' };\r\n      } catch (error) {\r\n        if (error.response?.status === 401) {\r\n          this.isAuthenticated = false;\r\n          this.showForm = false;\r\n          this.$router.push('/login');\r\n        } else {\r\n          alert('Error: ' + (error.response?.data?.message || 'Order submission failed'));\r\n        }\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.car-detail-container {\r\n  @apply container mx-auto px-4 py-8 flex flex-col lg:flex-row gap-8;\r\n}\r\n\r\n.order-form {\r\n  @apply bg-gray-50 p-6 rounded-lg;\r\n}\r\n\r\ninput {\r\n  @apply w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500;\r\n}\r\n</style>"],"mappings":";AAyCA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,GAAG,EAAE,IAAI;MAAE;MACXC,eAAe,EAAE,KAAK;MACtBC,QAAQ,EAAE,KAAK;MACfC,SAAS,EAAE;QACTC,IAAI,EAAE,EAAE;QACRC,