{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { reactive, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'RegisterPage',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const error = ref('');\n    const isLoading = ref(false);\n    const formData = reactive({\n      username: '',\n      email: '',\n      password1: '',\n      password2: ''\n    });\n    const handleSubmit = async () => {\n      try {\n        isLoading.value = true;\n        error.value = '';\n        if (formData.password1 !== formData.password2) {\n          error.value = 'Passwords do not match';\n          return;\n        }\n        await store.dispatch('register', {\n          username: formData.username,\n          email: formData.email,\n          password: formData.password1,\n          password2: formData.password2\n        });\n        router.push('/login');\n      } catch (err) {\n        error.value = err.response?.data?.message || 'Registration failed. Please try again.';\n      } finally {\n        isLoading.value = false;\n      }\n    };\n    return {\n      formData,\n      handleSubmit,\n      error,\n      isLoading\n    };\n  }\n};","map":{"version":3,"names":["reactive","ref","useStore","useRouter","name","setup","store","router","error","isLoading","formData","username","email","password1","password2","handleSubmit","value","dispatch","password","push","err","response","data","message"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\RegisterPage.vue"],"sourcesContent":["<template>\r\n    <div class=\"register-form\">\r\n      <h2>Register</h2>\r\n      <div v-if=\"error\" class=\"error-message\">\r\n        {{ error }}\r\n      </div>\r\n      <form @submit.prevent=\"handleSubmit\">\r\n        <div class=\"form-group\">\r\n          <label>Username:</label>\r\n          <input \r\n            type=\"text\" \r\n            v-model=\"formData.username\" \r\n            required\r\n          >\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label>Email:</label>\r\n          <input \r\n            type=\"email\" \r\n            v-model=\"formData.email\" \r\n            required\r\n          >\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label>Password:</label>\r\n          <input \r\n            type=\"password\" \r\n            v-model=\"formData.password1\" \r\n            required\r\n          >\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label>Confirm Password:</label>\r\n          <input \r\n            type=\"password\" \r\n            v-model=\"formData.password2\" \r\n            required\r\n          >\r\n        </div>\r\n        <button type=\"submit\" :disabled=\"isLoading\">\r\n          {{ isLoading ? 'Registering...' : 'Register' }}\r\n        </button>\r\n      </form>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { reactive, ref } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import { useRouter } from 'vue-router'\r\n  \r\n  export default {\r\n    name: 'RegisterPage',\r\n    setup() {\r\n      const store = useStore()\r\n      const router = useRouter()\r\n      const error = ref('')\r\n      const isLoading = ref(false)\r\n  \r\n      const formData = reactive({\r\n        username: '',\r\n        email: '',\r\n        password1: '',\r\n        password2: ''\r\n      })\r\n  \r\n      const handleSubmit = async () => {\r\n        try {\r\n          isLoading.value = true\r\n          error.value = ''\r\n  \r\n          if (formData.password1 !== formData.password2) {\r\n            error.value = 'Passwords do not match'\r\n            return\r\n          }\r\n  \r\n          await store.dispatch('register', {\r\n            username: formData.username,\r\n            email: formData.email,\r\n            password: formData.password1,\r\n            password2: formData.password2\r\n          })\r\n  \r\n          router.push('/login')\r\n        } catch (err) {\r\n          error.value = err.response?.data?.message || 'Registration failed. Please try again.'\r\n        } finally {\r\n          isLoading.value = false\r\n        }\r\n      }\r\n  \r\n      return {\r\n        formData,\r\n        handleSubmit,\r\n        error,\r\n        isLoading\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  \r\n  <style scoped>\r\n  .error-message {\r\n    color: red;\r\n    margin-bottom: 1rem;\r\n    padding: 0.5rem;\r\n    background-color: #ffebee;\r\n    border: 1px solid #ffcdd2;\r\n    border-radius: 4px;\r\n    }\r\n\r\n\r\n  .register-form {\r\n    max-width: 400px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n  }\r\n  \r\n  .form-group {\r\n    margin-bottom: 15px;\r\n  }\r\n  \r\n  label {\r\n    display: block;\r\n    margin-bottom: 5px;\r\n    font-weight: bold;\r\n  }\r\n  \r\n  input {\r\n    width: 100%;\r\n    padding: 8px;\r\n    margin-top: 5px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n  }\r\n  \r\n  button {\r\n    width: 100%;\r\n    padding: 10px;\r\n    background-color: #4CAF50;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    font-size: 16px;\r\n  }\r\n  \r\n  button:hover {\r\n    background-color: #45a049;\r\n  }\r\n  \r\n  .error {\r\n    color: red;\r\n    margin-top: 10px;\r\n  }\r\n  \r\n  .login-link {\r\n    text-align: center;\r\n    margin-top: 15px;\r\n  }\r\n  \r\n  .login-link a {\r\n    color: #4CAF50;\r\n    text-decoration: none;\r\n  }\r\n  \r\n  .login-link a:hover {\r\n    text-decoration: underline;\r\n  }\r\n  </style>"],"mappings":";AA+CE,SAASA,QAAQ,EAAEC,GAAE,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IACzB,MAAMK,KAAI,GAAIP,GAAG,CAAC,EAAE;IACpB,MAAMQ,SAAQ,GAAIR,GAAG,