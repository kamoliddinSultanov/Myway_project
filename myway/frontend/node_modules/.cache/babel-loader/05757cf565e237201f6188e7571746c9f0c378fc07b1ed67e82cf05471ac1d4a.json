{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      isAuthenticated: false,\n      // Статус авторизации\n      showForm: false,\n      // Показывать ли форму\n      orderForm: {\n        name: '',\n        email: '',\n        phone: ''\n      }\n    };\n  },\n  async created() {\n    await this.checkAuth(); // Проверяем авторизацию при создании компонента\n  },\n  methods: {\n    async checkAuth() {\n      try {\n        const response = await axios.get('http://localhost:8000/api/authenticated/', {\n          withCredentials: true\n        });\n        this.isAuthenticated = response.data.isAuthenticated;\n      } catch (error) {\n        console.error('Auth check error:', error);\n        this.isAuthenticated = false;\n      }\n    },\n    async handleRequestOrder() {\n      // Всегда проверяем актуальный статус перед действием\n      await this.checkAuth();\n      if (this.isAuthenticated) {\n        // Показываем/скрываем форму для авторизованных\n        this.showForm = !this.showForm;\n      } else {\n        // Перенаправляем на страницу входа для неавторизованных\n        this.$router.push({\n          name: 'LoginPage'\n        });\n        // Можно добавить сообщение:\n        alert('Please login to place an order');\n      }\n    },\n    async submitOrder() {\n      try {\n        await axios.post('http://localhost:8000/api/request-order/', this.orderForm, {\n          withCredentials: true\n        });\n        alert('Order submitted successfully!');\n        this.showForm = false;\n        this.orderForm = {\n          name: '',\n          email: '',\n          phone: ''\n        };\n      } catch (error) {\n        if (error.response?.status === 401) {\n          // Если сессия устарела\n          this.isAuthenticated = false;\n          this.showForm = false;\n          this.$router.push('/login');\n        } else {\n          alert('Error: ' + (error.response?.data?.message || 'Order submission failed'));\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","isAuthenticated","showForm","orderForm","name","email","phone","created","checkAuth","methods","response","get","withCredentials","error","console","handleRequestOrder","$router","push","alert","submitOrder","post","status","message"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"car-detail-container\">\r\n    <!-- Кнопка видна всегда -->\r\n    <button @click=\"handleRequestOrder\">Request Order</button>\r\n\r\n    <!-- Форма показывается ТОЛЬКО для авторизованных -->\r\n    <div v-if=\"isAuthenticated && showForm\" class=\"order-form\">\r\n      <form @submit.prevent=\"submitOrder\">\r\n        <input v-model=\"orderForm.name\" placeholder=\"Full Name\" required />\r\n        <input v-model=\"orderForm.email\" type=\"email\" placeholder=\"Email\" required />\r\n        <input v-model=\"orderForm.phone\" type=\"tel\" placeholder=\"Phone Number\" required />\r\n        <button type=\"submit\">Submit Order</button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      isAuthenticated: false, // Статус авторизации\r\n      showForm: false,        // Показывать ли форму\r\n      orderForm: {\r\n        name: '',\r\n        email: '',\r\n        phone: '',\r\n      },\r\n    };\r\n  },\r\n  async created() {\r\n    await this.checkAuth(); // Проверяем авторизацию при создании компонента\r\n  },\r\n  methods: {\r\n    async checkAuth() {\r\n      try {\r\n        const response = await axios.get('http://localhost:8000/api/authenticated/', {\r\n          withCredentials: true\r\n        });\r\n        this.isAuthenticated = response.data.isAuthenticated;\r\n      } catch (error) {\r\n        console.error('Auth check error:', error);\r\n        this.isAuthenticated = false;\r\n      }\r\n    },\r\n    async handleRequestOrder() {\r\n      // Всегда проверяем актуальный статус перед действием\r\n      await this.checkAuth();\r\n\r\n      if (this.isAuthenticated) {\r\n        // Показываем/скрываем форму для авторизованных\r\n        this.showForm = !this.showForm;\r\n      } else {\r\n        // Перенаправляем на страницу входа для неавторизованных\r\n        this.$router.push({ name: 'LoginPage' });\r\n        // Можно добавить сообщение:\r\n        alert('Please login to place an order');\r\n      }\r\n    },\r\n    async submitOrder() {\r\n      try {\r\n        await axios.post(\r\n          'http://localhost:8000/api/request-order/',\r\n          this.orderForm,\r\n          { withCredentials: true }\r\n        );\r\n        alert('Order submitted successfully!');\r\n        this.showForm = false;\r\n        this.orderForm = { name: '', email: '', phone: '' };\r\n      } catch (error) {\r\n        if (error.response?.status === 401) {\r\n          // Если сессия устарела\r\n          this.isAuthenticated = false;\r\n          this.showForm = false;\r\n          this.$router.push('/login');\r\n        } else {\r\n          alert('Error: ' + (error.response?.data?.message || 'Order submission failed'));\r\n        }\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":";AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,eAAe,EAAE,KAAK;MAAE;MACxBC,QAAQ,EAAE,KAAK;MAAS;MACxBC,SAAS,EAAE;QACTC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE;MACT;IACF,CAAC;EACH,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,SAAS,CAAC,CAAC,EAAE;EAC1B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,SAASA,CAAA,EAAG;MAChB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMX,KAAK,CAACY,GAAG,CAAC,0CAA0C,EAAE;UAC3EC,eAAe,EAAE;QACnB,CAAC,CAAC;QACF,IAAI,CAACX,eAAc,GAAIS,QAAQ,CAACV,IAAI,CAACC,eAAe;MACtD,EAAE,OAAOY,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,mBAAmB,EAAEA,KAAK,CAAC;QACzC,IAAI,CAACZ,eAAc,GAAI,KAAK;MAC9B;IACF,C