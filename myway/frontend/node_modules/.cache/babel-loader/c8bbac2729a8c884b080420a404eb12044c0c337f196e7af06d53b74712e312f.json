{"ast":null,"code":"import axios from 'axios';\nexport default {\n  data() {\n    return {\n      isAuthenticated: false,\n      // Пользователь авторизован?\n      showForm: false,\n      // Показать форму?\n      orderForm: {\n        name: '',\n        email: '',\n        phone: ''\n      }\n    };\n  },\n  created() {\n    // Проверяем, авторизован ли пользователь\n    axios.get('http://localhost:8000/api/authenticated/', {\n      withCredentials: true\n    }).then(response => {\n      this.isAuthenticated = response.data.isAuthenticated;\n    }).catch(() => {\n      this.isAuthenticated = false;\n    });\n  },\n  methods: {\n    redirectToLogin() {\n      window.location.href = '/login'; // Перенаправляем на логин\n    },\n    submitOrder() {\n      // Логика отправки заказа\n      console.log('Order submitted:', this.orderForm);\n    }\n  }\n};","map":{"version":3,"names":["axios","data","isAuthenticated","showForm","orderForm","name","email","phone","created","get","withCredentials","then","response","catch","methods","redirectToLogin","window","location","href","submitOrder","console","log"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"car-detail-container\">\r\n    <!-- Если пользователь авторизован, показываем форму -->\r\n    <button v-if=\"isAuthenticated\" @click=\"showForm = true\">Request Order</button>\r\n\r\n    <!-- Если пользователь не авторизован, показываем кнопку с переходом -->\r\n    <button v-else @click=\"redirectToLogin\">Login to Order</button>\r\n\r\n    <!-- Форма для заказа -->\r\n    <div v-if=\"showForm\">\r\n      <form @submit.prevent=\"submitOrder\">\r\n        <input v-model=\"orderForm.name\" placeholder=\"Full Name\" required />\r\n        <input v-model=\"orderForm.email\" placeholder=\"Email\" required />\r\n        <input v-model=\"orderForm.phone\" placeholder=\"Phone Number\" required />\r\n        <button type=\"submit\">Submit Order</button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      isAuthenticated: false, // Пользователь авторизован?\r\n      showForm: false, // Показать форму?\r\n      orderForm: {\r\n        name: '',\r\n        email: '',\r\n        phone: '',\r\n      },\r\n    };\r\n  },\r\n  created() {\r\n    // Проверяем, авторизован ли пользователь\r\n    axios.get('http://localhost:8000/api/authenticated/', { withCredentials: true })\r\n      .then(response => {\r\n        this.isAuthenticated = response.data.isAuthenticated;\r\n      })\r\n      .catch(() => {\r\n        this.isAuthenticated = false;\r\n      });\r\n  },\r\n  methods: {\r\n    redirectToLogin() {\r\n      window.location.href = '/login'; // Перенаправляем на логин\r\n    },\r\n    submitOrder() {\r\n      // Логика отправки заказа\r\n      console.log('Order submitted:', this.orderForm);\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":"AAqBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,eAAe,EAAE,KAAK;MAAE;MACxBC,QAAQ,EAAE,KAAK;MAAE;MACjBC,SAAS,EAAE;QACTC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE;MACT;IACF,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACAR,KAAK,CAACS,GAAG,CAAC,0CAA0C,EAAE;MAAEC,eAAe,EAAE;IAAK,CAAC,EAC5EC,IAAI,CAACC,QAAO,IAAK;MAChB,IAAI,CAACV,eAAc,GAAIU,QAAQ,CAACX,IAAI,CAACC,eAAe;IACtD,CAAC,EACAW,KAAK,CAAC,MAAM;MACX,IAAI,CAACX,eAAc,GAAI,KAAK;IAC9B,CAAC,CAAC;EACN,CAAC;EACDY,OAAO,EAAE;IACPC,eAAeA,CAAA,EAAG;MAChBC,MAAM,CAACC,QAAQ,CAACC,IAAG,GAAI,QAAQ,EAAE;IACnC,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ;MACAC,OAAO,CAACC,GAAG,CAAC,kBAAkB,EAAE,IAAI,CAACjB,SAAS,CAAC;IACjD;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}