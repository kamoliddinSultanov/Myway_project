{"ast":null,"code":"import axios from 'axios';\nexport default {\n  data() {\n    return {\n      isAuthenticated: false,\n      // Пользователь авторизован?\n      showForm: false,\n      // Отображение формы\n      orderForm: {\n        name: '',\n        email: '',\n        phone: ''\n      }\n    };\n  },\n  created() {\n    // Проверяем, авторизован ли пользователь\n    axios.get('http://localhost:8000/api/authenticated/', {\n      withCredentials: true\n    }).then(response => {\n      if (response.data.isAuthenticated) {\n        this.isAuthenticated = true; // Пользователь авторизован\n      } else {\n        this.isAuthenticated = false; // Пользователь не авторизован\n      }\n    }).catch(error => {\n      console.error('Ошибка проверки авторизации:', error);\n      this.isAuthenticated = false; // Ошибка, считаем, что пользователь не авторизован\n    });\n  },\n  methods: {\n    redirectToLogin() {\n      // Перенаправляем пользователя на страницу логина\n      window.location.href = '/login';\n    },\n    submitOrder() {\n      // Логика отправки заказа\n      console.log('Order submitted:', this.orderForm);\n    }\n  }\n};","map":{"version":3,"names":["axios","data","isAuthenticated","showForm","orderForm","name","email","phone","created","get","withCredentials","then","response","catch","error","console","methods","redirectToLogin","window","location","href","submitOrder","log"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"car-detail-container\">\r\n    <!-- Если пользователь авторизован, показываем кнопку для заказа -->\r\n    <button v-if=\"isAuthenticated\" @click=\"showForm = true\">Request Order</button>\r\n\r\n    <!-- Если пользователь не авторизован, показываем кнопку для входа -->\r\n    <button v-else @click=\"redirectToLogin\">Login to Order</button>\r\n\r\n    <!-- Форма для заказа -->\r\n    <div v-if=\"showForm\">\r\n      <form @submit.prevent=\"submitOrder\">\r\n        <input v-model=\"orderForm.name\" placeholder=\"Full Name\" required />\r\n        <input v-model=\"orderForm.email\" placeholder=\"Email\" required />\r\n        <input v-model=\"orderForm.phone\" placeholder=\"Phone Number\" required />\r\n        <button type=\"submit\">Submit Order</button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      isAuthenticated: false, // Пользователь авторизован?\r\n      showForm: false, // Отображение формы\r\n      orderForm: {\r\n        name: '',\r\n        email: '',\r\n        phone: '',\r\n      },\r\n    };\r\n  },\r\n  created() {\r\n    // Проверяем, авторизован ли пользователь\r\n    axios.get('http://localhost:8000/api/authenticated/', { withCredentials: true })\r\n      .then(response => {\r\n        if (response.data.isAuthenticated) {\r\n          this.isAuthenticated = true; // Пользователь авторизован\r\n        } else {\r\n          this.isAuthenticated = false; // Пользователь не авторизован\r\n        }\r\n      })\r\n      .catch(error => {\r\n        console.error('Ошибка проверки авторизации:', error);\r\n        this.isAuthenticated = false; // Ошибка, считаем, что пользователь не авторизован\r\n      });\r\n  },\r\n  methods: {\r\n    redirectToLogin() {\r\n      // Перенаправляем пользователя на страницу логина\r\n      window.location.href = '/login';\r\n    },\r\n    submitOrder() {\r\n      // Логика отправки заказа\r\n      console.log('Order submitted:', this.orderForm);\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":"AAqBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,eAAe,EAAE,KAAK;MAAE;MACxBC,QAAQ,EAAE,KAAK;MAAE;MACjBC,SAAS,EAAE;QACTC,IAAI,EAAE,EAAE;QACRC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE;MACT;IACF,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACAR,KAAK,CAACS,GAAG,CAAC,0CAA0C,EAAE;MAAEC,eAAe,EAAE;IAAK,CAAC,EAC5EC,IAAI,CAACC,