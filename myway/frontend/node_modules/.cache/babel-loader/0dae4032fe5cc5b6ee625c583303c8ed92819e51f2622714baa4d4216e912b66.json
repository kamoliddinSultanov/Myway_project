{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'CarDetail',\n  props: {\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  data() {\n    return {\n      car: {}\n    };\n  },\n  created() {\n    //const carId = this.$route.params.id;\n    const carId = this.id;\n    axios.get(`http://localhost:8000/api/cars/${carId}/`).then(response => {\n      this.car = response.data;\n    }).catch(error => {\n      console.error('There was an error fetching the car details!', error);\n    });\n  }\n};","map":{"version":3,"names":["axios","name","props","id","type","String","required","data","car","created","carId","get","then","response","catch","error","console"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"car-detail-container p-8 bg-gray-100 flex flex-col lg:flex-row gap-8\">\r\n    <!-- Left Section: Image -->\r\n    <div class=\"car-image w-full lg:w-1/2\">\r\n      <img :src=\"car.image\" alt=\"Car Image\" class=\"rounded-lg w-full h-auto shadow-md\" />\r\n    </div>\r\n\r\n    <!-- Right Section: Details -->\r\n    <div class=\"car-details w-full lg:w-1/2 bg-white p-6 rounded-lg shadow-md flex flex-col justify-between\">\r\n      <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">{{ car.title }}</h1>\r\n      <p class=\"text-gray-600 mb-2\"><strong>Brand:</strong> {{ car.brand }}</p>\r\n      <p class=\"text-gray-600 mb-2\"><strong>Model:</strong> {{ car.model }}</p>\r\n      <p class=\"text-2xl font-bold text-gray-800 mb-6\">${{ car.price }}</p>\r\n      <p class=\"text-gray-600 mb-4\">{{ car.description }}</p>\r\n      \r\n      <!-- Add to Cart Button -->\r\n      <button \r\n        @click=\"handleRequestOrder\"\r\n        class=\"bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300 ease-in-out\"\r\n      >\r\n        Request Order\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n  \r\n  <script>\r\n  import axios from 'axios';\r\n  export default {\r\n    name: 'CarDetail',\r\n    props: {\r\n      id: {\r\n        type: String,\r\n        required: true\r\n      }\r\n    },\r\n    data() {\r\n      return {\r\n        car: {}\r\n      };\r\n    },\r\n    created() {\r\n      //const carId = this.$route.params.id;\r\n      const carId = this.id;\r\n      axios.get(`http://localhost:8000/api/cars/${carId}/`)\r\n        .then(response => {\r\n          this.car = response.data;\r\n        })\r\n        .catch(error => {\r\n          console.error('There was an error fetching the car details!', error);\r\n        });\r\n    },\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .car-detail {\r\n    text-align: center;\r\n    margin-top: 50px;\r\n  }\r\n  .car-detail img {\r\n    width: 100%;\r\n    height: auto;\r\n  }\r\n  </style>"],"mappings":"AA4BE,OAAOA,KAAI,MAAO,OAAO;AACzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE;IACLC,EAAE,EAAE;MACFC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,GAAG,EAAE,CAAC;IACR,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACA,MAAMC,KAAI,GAAI,IAAI,CAACP,EAAE;IACrBH,KAAK,CAACW,GAAG,CAAC,kCAAkCD,KAAK,GAAG,EACjDE,IAAI,CAACC,QAAO,IAAK;MAChB,IAAI,CAACL,GAAE,GAAIK,QAAQ,CAACN,IAAI;IAC1B,CAAC,EACAO,KAAK,CAACC,KAAI,IAAK;MACdC,OAAO,CAACD,KAAK,CAAC,8CAA8C,EAAEA,KAAK,CAAC;IACtE,CAAC,CAAC;EACN;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}