{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  data() {\n    return {\n      car: null,\n      isAuthenticated: false,\n      showForm: false,\n      authModalVisible: false,\n      orderForm: {\n        name: '',\n        email: '',\n        phone: ''\n      }\n    };\n  },\n  async created() {\n    await this.fetchCar();\n    await this.checkAuth();\n  },\n  methods: {\n    async fetchCar() {\n      try {\n        const carId = this.$route.params.id;\n        const response = await axios.get(`http://localhost:8000/api/cars/${carId}/`);\n        this.car = response.data;\n      } catch (error) {\n        console.error('Error fetching car:', error);\n        this.$router.push('/catalogue');\n      }\n    },\n    getImageUrl(imagePath) {\n      if (!imagePath) return '';\n      return imagePath.startsWith('http') ? imagePath : `http://localhost:8000${imagePath}`;\n    },\n    formatPrice(price) {\n      return parseFloat(price).toLocaleString();\n    },\n    async checkAuth() {\n      try {\n        const response = await axios.get('http://localhost:8000/api/authenticated/', {\n          withCredentials: true\n        });\n        this.isAuthenticated = response.data.isAuthenticated;\n      } catch (error) {\n        console.error('Auth check error:', error);\n        this.isAuthenticated = false;\n      }\n    },\n    async handleRequestOrder() {\n      await this.checkAuth();\n      if (this.isAuthenticated) {\n        this.showForm = true;\n        this.authModalVisible = false;\n      } else {\n        this.authModalVisible = true;\n        this.showForm = false;\n      }\n    },\n    redirectToLogin() {\n      this.authModalVisible = false;\n      this.$router.push({\n        name: 'LoginPage'\n      });\n    },\n    async submitOrder() {\n      try {\n        const payload = {\n          ...this.orderForm,\n          car: {\n            title: this.car.title,\n            brand: this.car.brand,\n            model: this.car.model,\n            price: this.car.price,\n            description: this.car.description\n          }\n        };\n        await axios.post('http://localhost:8000/api/request-order/', payload, {\n          withCredentials: true\n        });\n        alert('Order submitted successfully!');\n        this.showForm = false;\n        this.orderForm = {\n          name: '',\n          email: '',\n          phone: ''\n        };\n      } catch (error) {\n        if (error.response?.status === 401) {\n          this.isAuthenticated = false;\n          this.showForm = false;\n          this.$router.push('/login');\n        } else {\n          alert('Error: ' + (error.response?.data?.message || 'Order submission failed'));\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","car","isAuthenticated","showForm","authModalVisible","orderForm","name","email","phone","created","fetchCar","checkAuth","methods","carId","$route","params","id","response","get","error","console","$router","push","getImageUrl","imagePath","startsWith","formatPrice","price","parseFloat","toLocaleString","withCredentials","handleRequestOrder","redirectToLogin","submitOrder","payload","title","brand","model","description","post","alert","status","message"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"max-w-7xl mx-auto px-4 py-8\" v-if=\"car\">\r\n    <div class=\"flex flex-col lg:flex-row gap-8 mb-12\">\r\n      <div class=\"lg:w-1/2\">\r\n        <img\r\n          :src=\"getImageUrl(car.image)\"\r\n          :alt=\"car.title\"\r\n          class=\"w-full h-auto rounded-xl shadow-lg object-cover\"\r\n        />\r\n      </div>\r\n\r\n      <div class=\"lg:w-1/2\">\r\n        <div class=\"bg-white p-8 rounded-xl shadow-lg\">\r\n          <h1 class=\"text-4xl font-bold text-gray-900 mb-4\">{{ car.title }}</h1>\r\n\r\n          <div class=\"grid grid-cols-2 gap-4 mb-6\">\r\n            <div>\r\n              <p class=\"text-sm text-gray-500\">Brand</p>\r\n              <p class=\"text-lg font-medium\">{{ car.brand }}</p>\r\n            </div>\r\n            <div>\r\n              <p class=\"text-sm text-gray-500\">Model</p>\r\n              <p class=\"text-lg font-medium\">{{ car.model }}</p>\r\n            </div>\r\n            <div>\r\n              <p class=\"text-sm text-gray-500\">Price</p>\r\n              <p class=\"text-2xl font-bold text-blue-600\">${{ formatPrice(car.price) }}</p>\r\n            </div>\r\n          </div>\r\n\r\n          <button\r\n            @click=\"handleRequestOrder\"\r\n            class=\"w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition duration-300\"\r\n          >\r\n            Request Order\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"bg-white p-8 rounded-xl shadow-lg mb-8\">\r\n      <h2 class=\"text-2xl font-semibold text-gray-900 mb-4\">Description</h2>\r\n      <p class=\"text-gray-700 leading-relaxed\">{{ car.description }}</p>\r\n    </div>\r\n\r\n    <div v-if=\"isAuthenticated && showForm\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50\">\r\n      <div class=\"bg-white rounded-xl shadow-xl w-full max-w-md\">\r\n\r\n        <div class=\"flex justify-between items-center border-b p-4\">\r\n          <h3 class=\"text-xl font-semibold\">Order Request</h3>\r\n          <button @click=\"showForm = false\" class=\"text-gray-500 hover:text-gray-700\">\r\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-6 w-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\r\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\" />\r\n            </svg>\r\n          </button>\r\n        </div>\r\n\r\n        <form @submit.prevent=\"submitOrder\" class=\"p-6 space-y-4\">\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Full Name</label>\r\n            <input\r\n              v-model=\"orderForm.name\"\r\n              required\r\n              class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500\"\r\n            >\r\n          </div>\r\n\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Email</label>\r\n            <input\r\n              v-model=\"orderForm.email\"\r\n              type=\"email\"\r\n              required\r\n              class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500\"\r\n            >\r\n          </div>\r\n\r\n          <div>\r\n            <label class=\"block text-sm font-medium text-gray-700 mb-1\">Phone</label>\r\n            <input\r\n              v-model=\"orderForm.phone\"\r\n              type=\"tel\"\r\n              required\r\n              class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500\"\r\n            >\r\n          </div>\r\n\r\n          <button\r\n            type=\"submit\"\r\n            class=\"w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition duration-300\"\r\n          >\r\n            Submit Order\r\n          </button>\r\n        </form>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-if=\"authModalVisible\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50\">\r\n      <div class=\"bg-white rounded-xl shadow-xl w-full max-w-md p-6\">\r\n        <h3 class=\"text-xl font-semibold mb-4\">Authorization Required</h3>\r\n        <p class=\"text-gray-700 mb-6\">You need to login to place an order.</p>\r\n        <div class=\"flex justify-end space-x-3\">\r\n          <button\r\n            @click=\"authModalVisible = false\"\r\n            class=\"px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50\"\r\n          >\r\n            Cancel\r\n          </button>\r\n          <button\r\n            @click=\"redirectToLogin\"\r\n            class=\"px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\r\n          >\r\n            Login\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div v-else class=\"flex justify-center items-center h-64\">\r\n    <div class=\"animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500\"></div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      car: null,\r\n      isAuthenticated: false,\r\n      showForm: false,\r\n      authModalVisible: false,\r\n      orderForm: {\r\n        name: '',\r\n        email: '',\r\n        phone: '',\r\n      },\r\n    };\r\n  },\r\n  async created() {\r\n    await this.fetchCar();\r\n    await this.checkAuth();\r\n  },\r\n  methods: {\r\n    async fetchCar() {\r\n      try {\r\n        const carId = this.$route.params.id;\r\n        const response = await axios.get(`http://localhost:8000/api/cars/${carId}/`);\r\n        this.car = response.data;\r\n      } catch (error) {\r\n        console.error('Error fetching car:', error);\r\n        this.$router.push('/catalogue');\r\n      }\r\n    },\r\n    getImageUrl(imagePath) {\r\n      if (!imagePath) return '';\r\n      return imagePath.startsWith('http') ? imagePath : `http://localhost:8000${imagePath}`;\r\n    },\r\n    formatPrice(price) {\r\n      return parseFloat(price).toLocaleString();\r\n    },\r\n    async checkAuth() {\r\n      try {\r\n        const response = await axios.get('http://localhost:8000/api/authenticated/', {\r\n          withCredentials: true\r\n        });\r\n        this.isAuthenticated = response.data.isAuthenticated;\r\n      } catch (error) {\r\n        console.error('Auth check error:', error);\r\n        this.isAuthenticated = false;\r\n      }\r\n    },\r\n    async handleRequestOrder() {\r\n      await this.checkAuth();\r\n\r\n      if (this.isAuthenticated) {\r\n        this.showForm = true;\r\n        this.authModalVisible = false;\r\n      } else {\r\n        this.authModalVisible = true;\r\n        this.showForm = false;\r\n      }\r\n    },\r\n    redirectToLogin() {\r\n      this.authModalVisible = false;\r\n      this.$router.push({ name: 'LoginPage' });\r\n    },\r\n    async submitOrder() {\r\n      try {\r\n        const payload = {\r\n          ...this.orderForm,\r\n          car: {\r\n            title: this.car.title,\r\n            brand: this.car.brand,\r\n            model: this.car.model,\r\n            price: this.car.price,\r\n            description: this.car.description\r\n          }\r\n        };\r\n\r\n        await axios.post(\r\n          'http://localhost:8000/api/request-order/',\r\n          payload,\r\n          { withCredentials: true }\r\n        );\r\n\r\n        alert('Order submitted successfully!');\r\n        this.showForm = false;\r\n        this.orderForm = { name: '', email: '', phone: '' };\r\n\r\n      } catch (error) {\r\n        if (error.response?.status === 401) {\r\n          this.isAuthenticated = false;\r\n          this.showForm = false;\r\n          this.$router.push('/login');\r\n        } else {\r\n          alert('Error: ' + (error.response?.data?.message || 'Order submission failed'));\r\n        }\r\n      }\r\n    }\r\n\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.modal-enter-active, .modal-leave-active {\r\n  transition: opacity 0.3s ease;\r\n}\r\n.modal-enter-from, .modal-leave-to {\r\n  opacity: 0;\r\n}\r\n\r\n::-webkit-scrollbar {\r\n  width: 8px;\r\n}\r\n::-webkit-scrollbar-track {\r\n  background: #f1f1f1;\r\n}\r\n::-webkit-scrollbar-thumb {\r\n  background: #888;\r\n  border-radius: 4px;\r\n}\r\n::-webkit-scrollbar-thumb:hover {\r\n  background: #555;\r\n}\r\n</style>"],"mappings":";AA6HA,OAAOA,KAAI,MAAO,OAAO;AAEzB