{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nexport default {\n  name: 'MainNavbar',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const isAuth = computed(() => store.state.isAuthenticated);\n    const currentUser = computed(() => store.state.user?.username);\n    const handleLogout = async () => {\n      try {\n        await store.dispatch('logout');\n        router.push('/login');\n      } catch (err) {\n        console.error('Logout failed:', err);\n      }\n    };\n    return {\n      isAuth,\n      currentUser,\n      handleLogout\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","useRouter","name","setup","store","router","isAuth","state","isAuthenticated","currentUser","user","username","handleLogout","dispatch","push","err","console","error"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\MainNavbar.vue"],"sourcesContent":["<template>\r\n  <nav class=\"navbar\">\r\n    <ul class=\"nav-left\">\r\n      <li>\r\n        <router-link to=\"/\">\r\n          <img src=\"@/assets/myway_logo.svg\" alt=\"Logo\" class=\"logo\" />\r\n        </router-link>\r\n      </li>\r\n      <li><router-link to=\"/\">Home</router-link></li>\r\n      <li><router-link to=\"/catalogue\">Catalogue</router-link></li>\r\n      <li><router-link to=\"/about-us\">About Us</router-link></li>\r\n    </ul>\r\n    <ul class=\"nav-right\">\r\n      <template v-if=\"!isAuth\">\r\n        <li><router-link to=\"/login\" class=\"auth-link\">Login</router-link></li>\r\n        <li><router-link to=\"/register\" class=\"auth-link\">Register</router-link></li>\r\n      </template>\r\n      <template v-else>\r\n        <li class=\"user-info\">\r\n          <span class=\"username\">{{ currentUser }}</span>\r\n        </li>\r\n        <li><button @click=\"handleLogout\" class=\"logout-btn\">Logout</button></li>\r\n      </template>\r\n    </ul>\r\n  </nav>\r\n</template>\r\n\r\n<script>\r\nimport { computed } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport { useRouter } from 'vue-router'\r\n\r\nexport default {\r\n  name: 'MainNavbar',\r\n  setup() {\r\n    const store = useStore()\r\n    const router = useRouter()\r\n\r\n    const isAuth = computed(() => store.state.isAuthenticated)\r\n    const currentUser = computed(() => store.state.user?.username)\r\n\r\n    const handleLogout = async () => {\r\n      try {\r\n        await store.dispatch('logout')\r\n        router.push('/login')\r\n      } catch (err) {\r\n        console.error('Logout failed:', err)\r\n      }\r\n    }\r\n\r\n    return {\r\n      isAuth,\r\n      currentUser,\r\n      handleLogout\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.navbar {\r\n  background-color: #333;\r\n  overflow: hidden;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  padding: 0 20px;\r\n}\r\n\r\n.nav-left, .nav-right {\r\n  list-style-type: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.navbar li {\r\n  float: left;\r\n}\r\n\r\n.navbar li a {\r\n  display: block;\r\n  color: white;\r\n  text-align: center;\r\n  padding: 14px 16px;\r\n  text-decoration: none;\r\n}\r\n\r\n.navbar li a:hover {\r\n  background-color: #111;\r\n}\r\n\r\n.logo {\r\n  width: 150px;\r\n  height: 40px;\r\n}\r\n\r\n.nav-left img{\r\n  width: 150px;\r\n}\r\n\r\n.auth-link {\r\n  color: #fff;\r\n  padding: 8px 16px;\r\n  border-radius: 4px;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.auth-link:hover {\r\n  background-color: #444;\r\n}\r\n\r\n.logout-btn {\r\n  background-color: #dc3545;\r\n  color: white;\r\n  border: none;\r\n  padding: 8px 16px;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  margin: 8px;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.logout-btn:hover {\r\n  background-color: #c82333;\r\n}\r\n\r\n.user-info {\r\n  color: #fff;\r\n  padding: 14px 16px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.username {\r\n  color: #fff;\r\n  margin-right: 10px;\r\n}\r\n</style>"],"mappings":";AA4BA,SAASA,QAAO,QAAS,KAAI;AAC7B,SAASC,QAAO,QAAS,MAAK;AAC9B,SAASC,SAAQ,QAAS,YAAW;AAErC,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIJ,QAAQ,CAAC;IACvB,MAAMK,MAAK,GAAIJ,SAAS,CAAC;IAEzB,MAAMK,MAAK,GAAIP,QAAQ,CAAC,MAAMK,KAAK,CAACG,KAAK,CAACC,eAAe;IACzD,MAAMC,WAAU,GAAIV,QAAQ,CAAC,MAAMK,KAAK,CAACG,KAAK,CAACG,IAAI,EAAEC,QAAQ;IAE7D,MAAMC,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF,MAAMR,KAAK,CAACS,QAAQ,CAAC,QAAQ;QAC7BR,MAAM,CAACS,IAAI,CAAC,QAAQ;MACtB,EAAE,OAAOC,GAAG,EAAE;QACZC,OAAO,CAACC,KAAK,CAAC,gBAAgB,EAAEF,GAAG;MACrC;IACF;IAEA,OAAO;MACLT,MAAM;MACNG,WAAW;MACXG;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}