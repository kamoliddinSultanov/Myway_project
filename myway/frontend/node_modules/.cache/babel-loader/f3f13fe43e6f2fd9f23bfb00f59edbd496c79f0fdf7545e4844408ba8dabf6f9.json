{"ast":null,"code":"import axios from '@/plugins/axios';\nexport default {\n  data() {\n    return {\n      isAuthenticated: false,\n      showForm: false,\n      orderForm: {\n        name: '',\n        email: '',\n        phone: ''\n      }\n    };\n  },\n  created() {\n    axios.get('/api/authenticated/').then(response => {\n      this.isAuthenticated = response.data.isAuthenticated || false;\n    }).catch(error => {\n      console.error('Ошибка проверки авторизации:', error);\n      this.isAuthenticated = false;\n    });\n  },\n  methods: {\n    handleRequestOrder() {\n      if (this.isAuthenticated) {\n        this.showForm = true;\n      } else {\n        this.redirectToLogin();\n      }\n    },\n    redirectToLogin() {\n      window.location.href = '/login';\n    },\n    submitOrder() {\n      axios.post('/api/request-order/', {\n        name: this.orderForm.name,\n        email: this.orderForm.email,\n        phone: this.orderForm.phone\n      }).then(response => {\n        alert('Order submitted successfully!');\n        this.showForm = false;\n      }).catch(error => {\n        if (error.response && error.response.status === 401) {\n          this.isAuthenticated = false;\n          this.redirectToLogin();\n        } else {\n          alert('Failed to submit the order. Please try again.');\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","data","isAuthenticated","showForm","orderForm","name","email","phone","created","get","then","response","catch","error","console","methods","handleRequestOrder","redirectToLogin","window","location","href","submitOrder","post","alert","status"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"car-detail-container\">\r\n    <button @click=\"handleRequestOrder\">Request Order</button>\r\n\r\n    <div v-if=\"isAuthenticated && showForm\" class=\"order-form\">\r\n      <form @submit.prevent=\"submitOrder\">\r\n        <input v-model=\"orderForm.name\" placeholder=\"Full Name\" required />\r\n        <input v-model=\"orderForm.email\" type=\"email\" placeholder=\"Email\" required />\r\n        <input v-model=\"orderForm.phone\" type=\"tel\" placeholder=\"Phone Number\" required />\r\n        <button type=\"submit\">Submit Order</button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from '@/plugins/axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      isAuthenticated: false,\r\n      showForm: false,\r\n      orderForm: {\r\n        name: '',\r\n        email: '',\r\n        phone: '',\r\n      },\r\n    };\r\n  },\r\n  created() {\r\n    axios.get('/api/authenticated/')\r\n      .then(response => {\r\n        this.isAuthenticated = response.data.isAuthenticated || false;\r\n      })\r\n      .catch(error => {\r\n        console.error('Ошибка проверки авторизации:', error);\r\n        this.isAuthenticated = false;\r\n      });\r\n  },\r\n  methods: {\r\n    handleRequestOrder() {\r\n      if (this.isAuthenticated) {\r\n        this.showForm = true;\r\n      } else {\r\n        this.redirectToLogin();\r\n      }\r\n    },\r\n    redirectToLogin() {\r\n      window.location.href = '/login';\r\n    },\r\n    submitOrder() {\r\n      axios.post('/api/request-order/', {\r\n        name: this.orderForm.name,\r\n        email: this.orderForm.email,\r\n        phone: this.orderForm.phone,\r\n      })\r\n      .then(response => {\r\n        alert('Order submitted successfully!');\r\n        this.showForm = false;\r\n      })\r\n      .catch(error => {\r\n        if (error.response && error.response.status === 401) {\r\n          this.isAuthenticated = false;\r\n          this.redirectToLogin();\r\n        } else {\r\n          alert('Failed to submit the order. Please try again.');\r\n        }\r\n      });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n.car-detail-container {\r\n  margin: 20px;\r\n}\r\n