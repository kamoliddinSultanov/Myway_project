{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'CarDetail',\n  props: {\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  data() {\n    return {\n      car: {},\n      // Данные автомобиля\n      isAuthenticated: false,\n      // Статус авторизации\n      showForm: false,\n      // Показ формы\n      orderForm: {\n        fullName: '',\n        email: '',\n        phone: ''\n      } // Данные формы\n    };\n  },\n  created() {\n    const carId = this.id;\n\n    // Fetch car details\n    axios.get(`http://localhost:8000/api/cars/${carId}/`).then(response => {\n      this.car = response.data;\n    }).catch(error => {\n      console.error('There was an error fetching the car details!', error);\n    });\n\n    // Check authentication status\n    axios.get('http://localhost:8000/api/authenticated/').then(response => {\n      this.isAuthenticated = response.data.isAuthenticated;\n    }).catch(err => {\n      this.isAuthenticated = false;\n    });\n  },\n  methods: {\n    handleOrderRequest() {\n      if (this.isAuthenticated) {\n        this.showForm = true; // Показываем форму, если пользователь авторизован\n      } else {\n        // Перенаправляем на страницу авторизации\n        window.location.href = '/login';\n      }\n    },\n    closeForm() {\n      this.showForm = false; // Закрываем форму\n    },\n    submitOrder() {\n      // Отправляем данные формы\n      console.log('Order submitted:', this.orderForm);\n      alert('Order submitted successfully!');\n      this.closeForm();\n    }\n  }\n};","map":{"version":3,"names":["axios","name","props","id","type","String","required","data","car","isAuthenticated","showForm","orderForm","fullName","email","phone","created","carId","get","then","response","catch","error","console","err","methods","handleOrderRequest","window","location","href","closeForm","submitOrder","log","alert"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"car-detail-container p-8 bg-gray-100 flex flex-col lg:flex-row gap-8\">\r\n    <!-- Left Section: Image -->\r\n    <div class=\"car-image w-full lg:w-1/2\">\r\n      <img :src=\"car.image\" alt=\"Car Image\" class=\"rounded-lg w-full h-auto shadow-md\" />\r\n    </div>\r\n\r\n    <!-- Right Section: Details -->\r\n    <div class=\"car-details w-full lg:w-1/2 bg-white p-6 rounded-lg shadow-md flex flex-col justify-between\">\r\n      <h1 class=\"text-3xl font-bold text-gray-800 mb-4\">{{ car.title }}</h1>\r\n      <p class=\"text-gray-600 mb-2\"><strong>Brand:</strong> {{ car.brand }}</p>\r\n      <p class=\"text-gray-600 mb-2\"><strong>Model:</strong> {{ car.model }}</p>\r\n      <p class=\"text-2xl font-bold text-gray-800 mb-6\">${{ car.price }}</p>\r\n      <p class=\"text-gray-600 mb-4\">{{ car.description }}</p>\r\n      \r\n      <!-- Order Request Button -->\r\n      <button \r\n        @click=\"handleOrderRequest\"\r\n        class=\"bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300 ease-in-out\"\r\n      >\r\n        Request Order\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Modal Form -->\r\n    <div \r\n      v-if=\"showForm\" \r\n      class=\"fixed inset-0 bg-gray-800 bg-opacity-50 flex items-center justify-center z-50\"\r\n    >\r\n      <div class=\"bg-white p-6 rounded-lg shadow-md w-96\">\r\n        <h2 class=\"text-xl font-bold text-gray-800 mb-4\">Order Request</h2>\r\n        <form @submit.prevent=\"submitOrder\">\r\n          <div class=\"mb-4\">\r\n            <label for=\"fullName\" class=\"block text-gray-600 mb-2\">Full Name:</label>\r\n            <input \r\n              type=\"text\" \r\n              id=\"fullName\" \r\n              v-model=\"orderForm.fullName\" \r\n              required \r\n              class=\"w-full border border-gray-300 rounded-lg p-2\"\r\n            />\r\n          </div>\r\n          <div class=\"mb-4\">\r\n            <label for=\"email\" class=\"block text-gray-600 mb-2\">Email:</label>\r\n            <input \r\n              type=\"email\" \r\n              id=\"email\" \r\n              v-model=\"orderForm.email\" \r\n              required \r\n              class=\"w-full border border-gray-300 rounded-lg p-2\"\r\n            />\r\n          </div>\r\n          <div class=\"mb-4\">\r\n            <label for=\"phone\" class=\"block text-gray-600 mb-2\">Phone Number:</label>\r\n            <input \r\n              type=\"text\" \r\n              id=\"phone\" \r\n              v-model=\"orderForm.phone\" \r\n              required \r\n              class=\"w-full border border-gray-300 rounded-lg p-2\"\r\n            />\r\n          </div>\r\n          <div class=\"flex justify-end gap-4\">\r\n            <button \r\n              type=\"button\" \r\n              @click=\"closeForm\"\r\n              class=\"bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded-lg\"\r\n            >\r\n              Cancel\r\n            </button>\r\n            <button \r\n              type=\"submit\" \r\n              class=\"bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg\"\r\n            >\r\n              Submit\r\n            </button>\r\n          </div>\r\n        </form>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'CarDetail',\r\n  props: {\r\n    id: {\r\n      type: String,\r\n      required: true\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      car: {}, // Данные автомобиля\r\n      isAuthenticated: false, // Статус авторизации\r\n      showForm: false, // Показ формы\r\n      orderForm: {\r\n        fullName: '',\r\n        email: '',\r\n        phone: ''\r\n      }, // Данные формы\r\n    };\r\n  },\r\n  created() {\r\n    const carId = this.id;\r\n\r\n    // Fetch car details\r\n    axios.get(`http://localhost:8000/api/cars/${carId}/`)\r\n      .then(response => {\r\n        this.car = response.data;\r\n      })\r\n      .catch(error => {\r\n        console.error('There was an error fetching the car details!', error);\r\n      });\r\n\r\n    // Check authentication status\r\n    axios.get('http://localhost:8000/api/authenticated/')\r\n      .then(response => {\r\n        this.isAuthenticated = response.data.isAuthenticated;\r\n      })\r\n      .catch(err => {\r\n        this.isAuthenticated = false;\r\n      });\r\n  },\r\n  methods: {\r\n    handleOrderRequest() {\r\n      if (this.isAuthenticated) {\r\n        this.showForm = true; // Показываем форму, если пользователь авторизован\r\n      } else {\r\n        // Перенаправляем на страницу авторизации\r\n        window.location.href = '/login';\r\n      }\r\n    },\r\n    closeForm() {\r\n      this.showForm = false; // Закрываем форму\r\n    },\r\n    submitOrder() {\r\n      // Отправляем данные формы\r\n      console.log('Order submitted:', this.orderForm);\r\n      alert('Order submitted successfully!');\r\n      this.closeForm();\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* TailwindCSS используется для стилизации */\r\n</style>"],"mappings":"AAoFA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE;IACLC,EAAE,EAAE;MACFC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,GAAG,EAAE,CAAC,CAAC;MAAE;MACTC,eAAe,EAAE,KAAK;MAAE;MACxBC,QAAQ,EAAE,KAAK;MAAE;MACjBC,SAAS,EAAE;QACTC,QAAQ,EAAE,EAAE;QACZC,KAAK,EAAE,EAAE;QACTC,KAAK,EAAE;MACT,CAAC,CAAE;IACL,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,KAAI,GAAI,IAAI,CAACb,EAAE;;IAErB;IACAH,KAAK,CAACiB,GAAG,CAAC,kCAAkCD,KAAK,GAAG,EACjDE,IAAI,CAACC,QAAO,IAAK;MAChB,IAAI,CAACX,GAAE,GAAIW,QAAQ,CAACZ,IAAI;IAC1B,CAAC,EACAa,KAAK,CAACC,KAAI,IAAK;MACdC,OAAO,CAACD,KAAK,CAAC,8CAA8C,EAAEA,KAAK,CAAC;IACtE,CAAC,CAAC;;IAEJ;IACArB,KAAK,CAACiB,GAAG,CAAC,0CAA0C,EACjDC,IAAI,CAACC,QAAO,IAAK;MAChB,IAAI,CAACV,eAAc,GAAIU,QAAQ,CAACZ,IAAI,CAACE,eAA