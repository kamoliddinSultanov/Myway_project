{"ast":null,"code":"import axios from 'axios';\nexport default {\n  data() {\n    return {\n      isAuthenticated: false,\n      // Проверка авторизации\n      showForm: false,\n      // Отображение формы для отправки заказа\n      orderForm: {\n        name: '',\n        email: '',\n        phone: ''\n      }\n    };\n  },\n  created() {\n    // Проверяем, авторизован ли пользователь\n    axios.get('http://localhost:8000/api/authenticated/', {\n      withCredentials: true\n    }).then(response => {\n      this.isAuthenticated = response.data.isAuthenticated || false;\n    }).catch(error => {\n      console.error('Ошибка проверки авторизации:', error);\n      this.isAuthenticated = false;\n    });\n  },\n  methods: {\n    handleRequestOrder() {\n      if (this.isAuthenticated) {\n        // Если пользователь авторизован, показываем форму\n        this.showForm = true;\n      } else {\n        // Если пользователь не авторизован, перенаправляем на логин\n        this.redirectToLogin();\n      }\n    },\n    redirectToLogin() {\n      // Перенаправляем пользователя на страницу логина\n      window.location.href = '/login';\n    },\n    submitOrder() {\n      // Логика отправки заказа\n      if (!this.orderForm.name || !this.orderForm.email || !this.orderForm.phone) {\n        alert('Please fill out all fields.');\n        return;\n      }\n      axios.post('http://localhost:8000/api/request-order/', {\n        name: this.orderForm.name,\n        email: this.orderForm.email,\n        phone: this.orderForm.phone\n      }, {\n        withCredentials: true\n      }).then(response => {\n        alert('Order submitted successfully!');\n        this.showForm = false; // Закрыть форму после успешной отправки\n      }).catch(error => {\n        console.error('Ошибка отправки заказа:', error);\n        alert('Failed to submit the order. Please try again.');\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","data","isAuthenticated","showForm","orderForm","name","email","phone","created","get","withCredentials","then","response","catch","error","console","methods","handleRequestOrder","redirectToLogin","window","location","href","submitOrder","alert","post"],"sources":["C:\\Users\\Asus\\Desktop\\MyWay Project\\myway\\frontend\\src\\components\\CarDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"car-detail-container\">\r\n    <!-- Кнопка Request Order доступна всем -->\r\n    <button @click=\"handleRequestOrder\">Request Order</button>\r\n\r\n    <!-- Форма для заказа отображается только для авторизованных пользователей -->\r\n    <div v-if=\"isAuthenticated && showForm\" class=\"order-form\">\r\n      <form @submit.prevent=\"submitOrder\">\r\n        <input v-model=\"orderForm.name\" placeholder=\"Full Name\" required />\r\n        <input v-model=\"orderForm.email\" type=\"email\" placeholder=\"Email\" required />\r\n        <input v-model=\"orderForm.phone\" type=\"tel\" placeholder=\"Phone Number\" required />\r\n        <button type=\"submit\">Submit Order</button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      isAuthenticated: false, // Проверка авторизации\r\n      showForm: false, // Отображение формы для отправки заказа\r\n      orderForm: {\r\n        name: '',\r\n        email: '',\r\n        phone: '',\r\n      },\r\n    };\r\n  },\r\n  created() {\r\n    // Проверяем, авторизован ли пользователь\r\n    axios\r\n      .get('http://localhost:8000/api/authenticated/', { withCredentials: true })\r\n      .then((response) => {\r\n        this.isAuthenticated = response.data.isAuthenticated || false;\r\n      })\r\n      .catch((error) => {\r\n        console.error('Ошибка проверки авторизации:', error);\r\n        this.isAuthenticated = false;\r\n      });\r\n  },\r\n  methods: {\r\n    handleRequestOrder() {\r\n      if (this.isAuthenticated) {\r\n        // Если пользователь авторизован, показываем форму\r\n        this.showForm = true;\r\n      } else {\r\n        // Если пользователь не авторизован, перенаправляем на логин\r\n        this.redirectToLogin();\r\n      }\r\n    },\r\n    redirectToLogin() {\r\n      // Перенаправляем пользователя на страницу логина\r\n      window.location.href = '/login';\r\n    },\r\n    submitOrder() {\r\n      // Логика отправки заказа\r\n      if (!this.orderForm.name || !this.orderForm.email || !this.orderForm.phone) {\r\n        alert('Please fill out all fields.');\r\n        return;\r\n      }\r\n\r\n      axios\r\n        .post(\r\n          'http://localhost:8000/api/request-order/',\r\n          {\r\n            name: this.orderForm.name,\r\n            email: this.orderForm.email,\r\n            phone: this.orderForm.phone,\r\n          },\r\n          { withCredentials: true }\r\n        )\r\n        .then((response) => {\r\n          alert('Order submitted successfully!');\r\n          this.showForm = false; // Закрыть форму после успешной отправки\r\n        })\r\n        .catch((error) => {\r\n          console.error('Ошибка отправки заказа:', error);\r\n          alert('Failed to submit the order. Please try again.');\r\n        });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style>\r\n.car-detail-container {\r\n  margin: 20px;\r\n}\r\n\r\nbutton {\r\n  margin: 10px 0;\r\n  padding: 10px 20px;\r\n  background-color: #007bff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\nbutton:hover {\r\n  background-color: #0056b3;\r\n}\r\n\r\n.order-form {\r\n  margin-top: 20px;\r\n}\r\n\r\ninput {\r\n  display: block;\r\n  margin: 10px 0;\r\n  padding: 10px;\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n}\r\n\r\nform button {\r\n  background-color: #28a745;\r\n}\r\n\r\nform button:hover {\r\n  background-color: #218838;\r\n}\r\n</style>"],"mappings":"AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,eAAe,EAAE,KAAK;MAAE;MACxBC,QAAQ,EA